#!/usr/bin/env bash
#This script displays the numbers 1-20, bad luck from china on the 4th iteration, bad luck from japan on the 9th, and bad luck from italy on the 17th
i=1
while [ "$i" -le 20 ]
do
    echo "$i"
    case "$i" in
        4)
            echo "bad luck from China"
            ;;
        9)
            echo "bad luck from Japan"
            ;;
        17)
            echo "bad luck from Italy"
            ;;
    esac
    i=$((i + 1))
done
